-- Drinked BoolValue
local function ensureDrinked(char)
    local dv = char:FindFirstChild("Drinked")

    if not dv then
        dv = Instance.new("BoolValue")
        dv.Name = "Drinked"
        dv.Value = true
        dv.Parent = char
    end

    return dv
end

local function updateVisual()
    local enabled = drinkedBoolean
        and drinkedBoolean.Value

    tween(toggleButton, {
        BackgroundColor3 = enabled
            and Color3.fromRGB(32, 182, 109)
            or Color3.fromRGB(90, 98, 110)
    })

    tween(knob, {
        Position = enabled
            and UDim2.fromOffset(28, 4)
            or UDim2.fromOffset(4, 4)
    })

    statusDot.BackgroundColor3 = enabled
        and Color3.fromRGB(55, 225, 139)
        or Color3.fromRGB(150, 155, 165)

    statusText.Text = enabled
        and "Currently enabled"
        or "Currently disabled"
end

local function toggleDrink()
    if not drinkedBoolean then return end

    drinkedBoolean.Value = not drinkedBoolean.Value
    updateVisual()
end

local function bindCharacter(char)
    if valueConnection then
        valueConnection:Disconnect()
        valueConnection = nil
    end

    drinkedBoolean = ensureDrinked(char)

    valueConnection = drinkedBoolean.Changed:Connect(
        updateVisual
    )

    updateVisual()
end

if player.Character then
    bindCharacter(player.Character)
end

player.CharacterAdded:Connect(bindCharacter)

toggleButton.MouseButton1Click:Connect(toggleDrink)

-- Change key
keyButton.MouseButton1Click:Connect(function()
    listeningForKey = true
    keyButton.Text = "Press key..."
    keyButton.TextSize = 11
end)

UIS.InputBegan:Connect(function(input, processed)
    if listeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard
            and input.KeyCode ~= Enum.KeyCode.Unknown then

            currentKey = input.KeyCode
            listeningForKey = false
            keyButton.Text = currentKey.Name .. "  ✎"
            keyButton.TextSize = 13
        end
        return
    end

    if processed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode == currentKey then
        toggleDrink()
    end
end)

-- Smooth draggable window
local dragging = false
local dragStart
local startPos
local dragInput

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

updateVisual()
