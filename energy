-- ORIGINAL ENERGY DRINK SYSTEM
--------------------------------------------------

-- This is the same method as your first script:
-- Character.Drinked.Value = true/false

local function ensureDrinkedOnCharacter(char)
    if not char then
        return nil
    end

    local dv = char:FindFirstChild("Drinked")

    if not dv then
        dv = Instance.new("BoolValue")
        dv.Name = "Drinked"
        dv.Value = true
        dv.Parent = char
    end

    return dv
end

--------------------------------------------------
-- UPDATE VISUALS
--------------------------------------------------

local function updateButtonVisual()
    local enabled = false

    if drinkedBoolean
        and drinkedBoolean.Parent
        and drinkedBoolean.Value then
        enabled = true
    end

    animate(toggleButton, {
        BackgroundColor3 = enabled
            and COLORS.Green
            or COLORS.Red
    })

    animate(knob, {
        Position = enabled
            and UDim2.fromOffset(28, 4)
            or UDim2.fromOffset(4, 4)
    })

    statusDot.BackgroundColor3 = enabled
        and Color3.fromRGB(55, 225, 139)
        or COLORS.Red

    statusText.Text = enabled
        and "Currently enabled"
        or "Currently disabled"
end

--------------------------------------------------
-- ORIGINAL TOGGLE METHOD
--------------------------------------------------

local function toggleDrink()
    if not drinkedBoolean then
        return
    end

    if not drinkedBoolean.Parent then
        return
    end

    -- Exact original behavior
    drinkedBoolean.Value = not drinkedBoolean.Value

    updateButtonVisual()
end

--------------------------------------------------
-- CHARACTER BINDING
--------------------------------------------------

local function bindToCharacter(char)
    if drinkConnection then
        drinkConnection:Disconnect()
        drinkConnection = nil
    end

    drinkedBoolean = nil

    if not char then
        updateButtonVisual()
        return
    end

    -- Original method
    drinkedBoolean = ensureDrinkedOnCharacter(char)

    if drinkedBoolean then
        updateButtonVisual()

        drinkConnection = drinkedBoolean.Changed:Connect(
            updateButtonVisual
        )
    end
end

-- Character may already exist
