--------------------------------------------------
-- ORIGINAL DRINKED METHOD
--------------------------------------------------

local function ensureDrinkedOnCharacter(character)
    if not character then
        return nil
    end

    local value = character:FindFirstChild("Drinked")

    if not value then
        value = Instance.new("BoolValue")
        value.Name = "Drinked"
        value.Value = true
        value.Parent = character
    end

    if not value:IsA("BoolValue") then
        warn("Drinked exists but is not a BoolValue")
        return nil
    end

    return value
end

--------------------------------------------------
-- APPLY ENERGY DRINK EFFECT
--------------------------------------------------

local function applyDrinkEffect()
    if not humanoid or not humanoid.Parent then
        return
    end

    if not drinkedBoolean then
        return
    end

    if drinkedBoolean.Value then
        -- Energy Drink ON
        humanoid.WalkSpeed = BOOST_SPEED
    else
        -- Energy Drink OFF
        humanoid.WalkSpeed = normalSpeed or 16
    end
end

--------------------------------------------------
-- UPDATE GUI
--------------------------------------------------

local function updateButtonVisual()
    local enabled =
        drinkedBoolean ~= nil
        and drinkedBoolean.Parent ~= nil
        and drinkedBoolean.Value

    tween(toggleButton, {
        BackgroundColor3 = enabled and GREEN or RED
    })

    tween(knob, {
        Position = enabled
            and UDim2.fromOffset(28, 4)
            or UDim2.fromOffset(4, 4)
    })

    statusDot.BackgroundColor3 = enabled and GREEN or RED
    statusText.Text = enabled
        and "Currently enabled"
        or "Currently disabled"
end

--------------------------------------------------
-- ORIGINAL TOGGLE FUNCTION
--------------------------------------------------

local function toggleDrink()
    if not drinkedBoolean or not drinkedBoolean.Parent then
        return
    end

    -- Original method
    drinkedBoolean.Value = not drinkedBoolean.Value

    applyDrinkEffect()
    updateButtonVisual()
end

--------------------------------------------------
-- CHARACTER BINDING
--------------------------------------------------

local function bindToCharacter(character)
    if drinkConnection then
        drinkConnection:Disconnect()
        drinkConnection = nil
    end

    drinkedBoolean = nil
    humanoid = nil
    normalSpeed = nil

    if not character then
        updateButtonVisual()
        return
    end

    humanoid = character:WaitForChild("Humanoid", 10)

    if not humanoid then
        warn("Energy Drink: Humanoid not found")
        return
    end

    normalSpeed = humanoid.WalkSpeed
    drinkedBoolean = ensureDrinkedOnCharacter(character)

    if not drinkedBoolean then
        return
    end

    drinkConnection = drinkedBoolean.Changed:Connect(function()
        applyDrinkEffect()
        updateButtonVisual()
    end)

    applyDrinkEffect()
    updateButtonVisual()
end

if player.Character then
    task.spawn(bindToCharacter, player.Character)
end

player.CharacterAdded:Connect(function(character)
    bindToCharacter(character)
end)

